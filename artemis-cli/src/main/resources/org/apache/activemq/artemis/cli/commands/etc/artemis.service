[Unit]
Description=Apache Artemis Service
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=${environment}
Environment="ARTEMIS_CONSOLE_PATTERN=%%-5level [%%logger] %%msg%%n"
Environment="ARTEMIS_FILE_LEVEL=OFF"
ExecStart=${exec-start}
TimeoutStopSec=60s
SuccessExitStatus=143
KillMode=mixed
LimitMEMLOCK=infinity
LimitNOFILE=524288
LimitNPROC=31438
LimitAS=infinity
LimitFSIZE=infinity
SendSIGKILL=no
NotifyAccess=all
Restart=always
RestartSec=10

#User and group with which to run the service, to avoid running as root
#User=artemis
#Group=artemis

#CPU Niceness parameter. Lower values mean higher CPU priority.
#Acceptable range is from +19 to -20. Default is 0.
#Nice=-10

#IO niceness parameters.
#IOSchedulingClass=best-effort
#IOSchedulingPriority=2

#
#Alias=

[Install]
WantedBy=multi-user.target
